# Money Maker configuration.  Copy to ".env" and fill in what you have.
# The app runs with none of these set, using only free sources.

# --- where it runs ---------------------------------------------------------
HOST=127.0.0.1
PORT=8000
# SQLite by default. For Postgres:
#   DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/moneymaker
# DATABASE_URL=

# --- AI-written outreach ---------------------------------------------------
# Without this, emails are written from deterministic templates instead.
# https://console.anthropic.com
ANTHROPIC_API_KEY=
LLM_MODEL_FAST=claude-haiku-4-5-20251001
LLM_MODEL_SMART=claude-sonnet-5
LLM_DAILY_COST_CAP_USD=25

# --- lead sources ----------------------------------------------------------
# All free. Get them in this order - the first matters most because it feeds
# all four campaigns and every result is a live website the audit can mine
# for an email address.
#
#   1. SERPER_API_KEY       https://serper.dev            2,500 searches free
#   2. ADZUNA_APP_ID/KEY    https://developer.adzuna.com  free tier
#   3. COMPANIES_HOUSE_KEY  https://developer.company-information.service.gov.uk
#   4. SAM_GOV_API_KEY      https://sam.gov/content/api-keys
#   5. YELP_API_KEY         https://docs.developer.yelp.com
#
# Free with no key at all, always on: UK Contracts Finder, UK Find a Tender,
# Hacker News, OpenStreetMap.
# Google Places: best business coverage. Paid per search.
#   https://console.cloud.google.com  (enable "Places API (New)")
SERPER_API_KEY=
YELP_API_KEY=
# Paid, per lookup. Best coverage, but the free sources above cover most of it.
GOOGLE_PLACES_KEY=

# Companies House: newly incorporated UK companies. FREE key.
#   https://developer.company-information.service.gov.uk
COMPANIES_HOUSE_KEY=

# Adzuna job ads: hiring signals. FREE tier.
#   https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# UK Contracts Finder and Hacker News need no key and are always on.

# --- sending ---------------------------------------------------------------
# Use a SEPARATE domain from your main one. A spam reputation on your primary
# domain stops client email and invoices being delivered.
# Prefer a real Google Workspace / Microsoft 365 mailbox: transactional
# providers (SendGrid, Postmark, SES) prohibit cold outreach in their terms.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_USE_SSL=false

# --- sender identity (REQUIRED before anything can be sent) ----------------
COMPANY_NAME=
COMPANY_WEBSITE=
# A real postal address. Legally required by US CAN-SPAM in every message.
COMPANY_POSTAL_ADDRESS=
SENDER_NAME=
SENDER_EMAIL=
PORTFOLIO_URL=
PRIVACY_POLICY_URL=
# Public URL used for unsubscribe links. Must be reachable by recipients.
PUBLIC_BASE_URL=http://127.0.0.1:8000

# --- limits ----------------------------------------------------------------
DAILY_EMAIL_CAP_GLOBAL=150
PER_MAILBOX_DAILY_CAP=40
COOLING_OFF_DAYS=90
MIN_SCORE_TO_EMAIL=55

# --- scheduler -------------------------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Kolkata

# --- dashboard login --------------------------------------------------------
# Required before deploying anywhere reachable from outside your own machine.
# Blank = no login (fine for localhost only). Once set, the dashboard asks for
# this password, then walks you through scanning a QR code with Google
# Authenticator the first time - every login after that needs both.
ADMIN_PASSWORD=
